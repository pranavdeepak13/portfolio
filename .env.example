# Public site configuration
NEXT_PUBLIC_RESUME_URL=https://drive.google.com/file/d/your-file-id/view

# Contact delivery (server only — never prefix these with NEXT_PUBLIC_)
RESEND_API_KEY=re_replace_me
RESEND_FROM=Portfolio <portfolio@your-verified-domain.example>
CONTACT_TO=private-recipient@example.com
# Optional; defaults to the visitor's validated email address.
REPLY_TO=

# Optional Google Sheets audit log
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB_NAME=Contact
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Set either the escaped PEM value or its base64-encoded equivalent.
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_SERVICE_ACCOUNT_KEY_B64=
